# 환경변수는 모두 이 파일 하나로 관리한다. `cp .env.example .env` 후 값을 채운다 (.env는 커밋 금지).
# 수동 실행: uv run --env-file .env ... / systemd: EnvironmentFile=-@PROJECT@/.env
# 주의: systemd는 줄 끝 주석을 값으로 읽으므로 주석은 항상 따로 한 줄에 쓴다.

# KIS Open API — 실전 (계좌번호는 앞 8자리)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCT_STOCK=
# KIS Open API — 모의 (계좌번호는 앞 8자리)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCT_STOCK=
# 공통: 계좌번호 뒤 2자리 (01: 종합계좌), HTS ID
KIS_ACCT_PROD=01
KIS_HTS_ID=

# pykrx 일부 함수(KRX 로그인 필요)
KRX_ID=
KRX_PW=

# 알림
SLACK_WEBHOOK_URL=
